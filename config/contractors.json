{
 "_comment": [
  "Roster + overrides for the contractor update agent.",
  "This file is NOT the source of truth for which contractors exist -- Trello is.",
  "Each weekly run discovers every label on the Insured Appraisals board that has at",
  "least one open card, and treats it as a client unless it appears in 'nonClientLabels'.",
  "This file supplies the things Trello cannot know: display names, email domains,",
  "per-rep splits, and the Send shareId once a page has been published."
 ],
 "board": {
  "name": "Insured Appraisals",
  "id": "ari:cloud:trello::board/workspace/65d7eb00496a914bf3ffb423/666e58adc67768660a580af4",
  "url": "https://trello.com/b/lAdc1ZW8/insured-appraisals"
 },
 "_repLabelComment": [
  "Rep attribution reads a Trello LABEL on the card first -- authoritative, see runbook Pass 0.",
  "'labelName' overrides the display 'name' when the Trello label is spelled differently.",
  "The connector can attach an existing label but CANNOT create one: new rep labels must be",
  "made in the Trello UI before a run can attach or read them."
 ],
 "gmail": {
  "contractorInboundLabel": "AA - Roofers emailing us",
  "contractorInboundLabelId": "Label_889619139836162734",
  "owner": "josephdittmanappraiser@gmail.com"
 },
 "_stageMapComment": [
  "The board has ~84 lists whose names carry operator instructions. Contractors see the",
  "client-facing stage, never the raw list name.",
  "TWO different orderings live here, do not conflate them:",
  "  * ARRAY ORDER = matching precedence. Lowercase the list name, walk this array in",
  "    order, first stage with a matching substring wins. Most specific stages come first,",
  "    which is why 'In umpire' precedes 'Settled' ('Umpire invoice paid' contains 'paid')",
  "    and why the payment-outstanding stage precedes 'Settled - paid' ('closed but not",
  "    paid' also contains 'paid').",
  "  * 'order' FIELD = display order on the page, sorted descending, so the files closest",
  "    to money appear first.",
  "If a list matches nothing it falls to 'New / intake' -- which is usually wrong, so the",
  "run must report any list that fell through and the matcher gets added here."
 ],
 "stageMap": [
  {
   "stage": "In umpire",
   "order": 8,
   "blurb": "The two appraisers did not agree, so an umpire is deciding the file.",
   "matchers": [
    "umpire"
   ]
  },
  {
   "stage": "Settled - payment outstanding",
   "order": 10,
   "blurb": "The claim is resolved. Our appraisal invoice is still open.",
   "matchers": [
    "not paid",
    "invoice + payment link",
    "past dues",
    "debt collection",
    "in iink",
    "legacy deals",
    "waiting on payment to sign award",
    "paid - waiting for appraiser",
    "close out"
   ]
  },
  {
   "stage": "Settled - paid",
   "order": 11,
   "blurb": "Closed out and paid. Nothing outstanding.",
   "matchers": [
    "paid"
   ]
  },
  {
   "stage": "Referred out (attorney or public adjuster)",
   "order": 9,
   "blurb": "Appraisal was not the right route. The file has moved to an attorney or a public adjuster.",
   "matchers": [
    "sent to attorney",
    "send to attorney",
    "in pa -",
    "in pa-"
   ]
  },
  {
   "stage": "Negotiating with the carrier's appraiser",
   "order": 7,
   "blurb": "Positions exchanged. We are working the gap.",
   "matchers": [
    "sent oa my position",
    "need to review oa",
    "reviewed oa",
    "carrier appraiser responded",
    "2nd offer is to low",
    "awaiting on opposing appraiser",
    "joseph did first review",
    "position written"
   ]
  },
  {
   "stage": "Inspected / building our position",
   "order": 6,
   "blurb": "Property inspected. Our estimate and position are being prepared.",
   "matchers": [
    "inspected",
    "estimate under review",
    "further ressearch",
    "estimate done but reassigned"
   ]
  },
  {
   "stage": "Inspection scheduling",
   "order": 5,
   "blurb": "The carrier's appraiser is named. Locking in the inspection date.",
   "matchers": [
    "carrier appraisers info provided",
    "carrier appraiser info provided",
    "need to confirm schedule",
    "scheduled",
    "for rescheduling"
   ]
  },
  {
   "stage": "Appraisal demanded / waiting on carrier",
   "order": 4,
   "blurb": "The demand is with the carrier. Waiting for them to name their appraiser.",
   "matchers": [
    "demand letters sent",
    "appraiser named but no",
    "no appraiser named",
    "homesite files",
    "state farm claims",
    "out of state"
   ]
  },
  {
   "stage": "Estimate sent - needs sign-off",
   "order": 3,
   "blurb": "The estimate is with you and/or the homeowner. We need approval to move.",
   "matchers": [
    "estimates sent",
    "waiting for roofer's go signal"
   ]
  },
  {
   "stage": "Estimate being prepared",
   "order": 2,
   "blurb": "We are writing the estimate.",
   "matchers": [
    "estimates prepared to send",
    "for supplement/or estimate only"
   ]
  },
  {
   "stage": "New / intake",
   "order": 1,
   "blurb": "File received. Confirming details before we demand appraisal.",
   "matchers": [
    "roofing company inquires",
    "still verifying",
    "pa inquires",
    "pa's and attorney inquires",
    "call homeowners",
    "direct customers",
    "triage"
   ]
  }
 ],
 "_debtCollectionNote": [
  "JUDGEMENT CALL, easy to change: files sitting in 'Need to send to debt collections',",
  "'Sent to Debt Collections' and 'PAST DUES' are shown to the client as",
  "'Settled - payment outstanding'. That is accurate -- the invoice IS open -- and it stops",
  "an automated page from picking a fight with a client on Joseph's behalf. If Joseph wants",
  "collections stated plainly, give those three lists their own stage here."
 ],
 "_excludeListsComment": [
  "Lists that do NOT hold client files. A card sitting in one of these is a contact record,",
  "an agent rule, a divider or a staff task -- never a file, so it must never reach a status",
  "page. Applied BEFORE stage mapping. Matched as lowercased substrings of the list name."
 ],
 "excludeLists": [
  "ai agent",
  "repeat clients",
  "appraisers info that works for us",
  "interested roofers",
  "admin work",
  "assignments",
  "new list"
 ],
 "_excludeCardMarkersComment": [
  "Markers Joseph writes into a card's name or description to say it is not a live appraisal",
  "file. A card carrying one never reaches a status page, whatever list it sits in.",
  "Matched case-insensitively against card name + description."
 ],
 "excludeCardMarkers": [
  "[NOT AN APPRAISAL]",
  "NOT AN APPRAISAL",
  "DO NOT SHOW",
  "TEST CARD"
 ],
 "_nonClientComment": "Labels that are markets, difficulty tags, staff assignments or workflow flags -- never a client. Matched case-insensitively.",
 "nonClientLabels": [
  "Houston",
  "Austin",
  "DFW",
  "San Antonio",
  "payments",
  "Mid level",
  "Easy",
  "Hard",
  "On Hold",
  "Lacking Info - need to follow up",
  "Call/ Follow up",
  "FOR RESCHEDULING",
  "Appraiser: joseph Dittman",
  "Needs PA (Joseph)",
  "Mark's task",
  "Erwin's task",
  "Direct Customer"
 ],
 "_contractorComment": [
  "pageMode 'per-rep'  -> one Send page per named rep, plus one catch-all page for that",
  "                      company's files with no rep resolved yet.",
  "pageMode 'company'  -> one Send page for the whole company (the default).",
  "shareId is written back by the weekly run the first time it publishes a page.",
  "aliasLabels folds duplicate/typo labels into one client."
 ],
